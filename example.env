# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.

# ----------------API-------------------
SECRET_KEY=replace_me

# ----------------Admin-Panel-----------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com

# ---------------Host-------------------
DOMAIN=localhost
# Comma-separated extra origins, on top of https://$DOMAIN / http://$DOMAIN
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=

# Traefik's externally-published ports (dev only — compose.prod.yaml exposes nginx directly instead)
HOST_HTTP_PORT=80
HOST_HTTPS_PORT=443

# -----------------Database (MySQL via ProxySQL)--------------
MYSQL_ROOT_PASSWORD=root
DEFAULT_DB_NAME=spine_segmentation
DB_USER=spine_segmentation_user
DB_PASSWORD=replace_me

# ----------------Redis (cache / session / celery broker, via RedisProxy)-----------------
REDIS_PASSWORD=replace_me

# ----------------MinIO (media-public / media-private object storage)------------------
MINIO_USER=minio
MINIO_PASSWORD=replace_me
