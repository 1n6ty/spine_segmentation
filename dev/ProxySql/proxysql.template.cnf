datadir="/var/lib/proxysql"

# --------------------------------------------------------------------
# 1. Admin Interface Configuration (Port 6032)
# --------------------------------------------------------------------
admin_variables={
    admin_credentials="admin:adminpassword"
    mysql_ifaces="0.0.0.0:6032"
}

# --------------------------------------------------------------------
# 2. Global Engine & Monitoring Settings
# --------------------------------------------------------------------
mysql_variables={
    threads=4
    max_connections=2048
    interfaces="0.0.0.0:6033"

    mysql-default_authentication_plugin="caching_sha2_password"

    # Credentials matching your initialization script
    monitor_username="proxysql_monitor"
    monitor_password="proxysql_monitor"
}

# --------------------------------------------------------------------
# 4. Backend Target Instantiations
# --------------------------------------------------------------------
# Seed nodes are initially placed into HG 40. ProxySQL will automatically
# move read-only nodes to HG 42 based on the results of the sys view.
mysql_servers =
(
    { address="mysql", port=3306, hostgroup=40, max_connections=1000, weight=1 },
    { address="mysql", port=3306, hostgroup=42, max_connections=1000, weight=1 }
)

# --------------------------------------------------------------------
# 5. Client Application Access Rules
# --------------------------------------------------------------------
mysql_users =
(
    # Unmatched traffic defaults to the writer pool (40) for safety
    # { username="app_user", password="app_secure_password", default_hostgroup=40, active=1 },
    { username="spine_segmentation_user", password="${DB_PASSWORD}", default_hostgroup=40, active=1, transaction_persistent=1 }
)

# --------------------------------------------------------------------
# 6. Optimized Routing Rules (Read/Write Splitting)
# --------------------------------------------------------------------
mysql_query_rules =
(
    # Rule 1: Route explicit write intentions/locks to the Writer pool (40)
    { rule_id=1, active=1, match_pattern="^SELECT .* FOR UPDATE", destination_hostgroup=40, apply=1 },
    
    # Rule 2: Route standard SELECT statements to the Reader pool (42)
    { rule_id=2, active=1, match_pattern="^SELECT", destination_hostgroup=42, apply=1 }
)